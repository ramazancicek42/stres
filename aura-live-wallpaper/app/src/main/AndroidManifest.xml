<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Işık sensörü için izin gerekmez (donanımsal) -->
    
    <!-- Ses analizi için mikrofon izni - sadece ekran açıkken kullanılır -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    
    <!-- Opsiyonel: İvmeölçer için izin gerekmez -->
    
    <!-- Live Wallpaper özelliği -->
    <uses-feature
        android:name="android.software.live_wallpaper"
        android:required="true" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AuraLiveWallpaper">

        <!-- Live Wallpaper Service Tanımı -->
        <service
            android:name=".service.AuraWallpaperService"
            android:exported="true"
            android:label="@string/wallpaper_name"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper_info" />
        </service>

        <!-- Ayarlar Aktivitesi -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="true"
            android:label="@string/settings_title"
            android:theme="@style/Theme.AuraLiveWallpaper">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
        </activity>

    </application>

</manifest>
