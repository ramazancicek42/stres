<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Işık sensörü için izin gerekmez (donanımsal) -->
    
    <!-- Ses analizi için mikrofon izni - sadece ekran açıkken kullanılır -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    
    <!-- Opsiyonel: İvmeölçer için izin gerekmez -->
    
    <!-- Live Wallpaper özelliği -->
    <uses-feature
        android:name="android.software.live_wallpaper"
        android:required="true" />

    <!-- Quick Settings Tile için -->
    <uses-permission android:name="android.permission.BIND_QUICK_SETTINGS_TILE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AuraLiveWallpaper">

        <!-- Live Wallpaper Service Tanımı -->
        <service
            android:name=".service.AuraWallpaperService"
            android:exported="true"
            android:label="@string/wallpaper_name"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper" />
        </service>

        <!-- Ayarlar Aktivitesi -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="true"
            android:label="@string/settings_title"
            android:theme="@style/Theme.AuraLiveWallpaper">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Meditasyon Geçmişi Aktivitesi -->
        <activity
            android:name=".meditation.SessionHistoryActivity"
            android:exported="false"
            android:label="Meditasyon Geçmişi"
            android:theme="@style/Theme.AuraLiveWallpaper" />

        <!-- Widget Provider -->
        <receiver
            android:name=".widget.AuraWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.aura.livewallpaper.ACTION_FREEZE" />
                <action android:name="com.aura.livewallpaper.ACTION_NEXT_PALETTE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_aura_info" />
        </receiver>

        <!-- Komut Receiver -->
        <receiver
            android:name=".service.AuraCommandReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.aura.livewallpaper.ACTION_TOGGLE_FREEZE" />
                <action android:name="com.aura.livewallpaper.ACTION_NEXT_PALETTE" />
            </intent-filter>
        </receiver>

        <!-- Quick Settings Tile -->
        <service
            android:name=".quicksettings.AuraTileService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="AURA Freeze"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>

</manifest>
